/*
  1단계 ① 토양수분 감지 모듈 — 흙의 목마름을 숫자로!
  ⚠ 키트 자료에는 A1로 나오지만, D1 R32에서는 A1 자리(GPIO4)가 WiFi와 겹쳐요.
     케이블을 확장쉴드의 **A2 줄**에 꽂으세요 → GPIO35
  결선: G(A2)→GND · V(A2)→VCC · S(A2)→AO
  주의: 센서의 전원부(위쪽 기판)에 물이 닿지 않게!

  ★ 이 키트의 센서는 "마를수록 값이 커지는" 타입으로 확인됐어요 (공기 중 ≈ 4095, 물속 ≈ 950).
    '2점 보정' 방식이라 마른 값·젖은 값을 직접 재서 넣으면
    0%(바싹 마름) ~ 100%(흠뻑 젖음)가 올바르게 나옵니다.
*/

// 핀 번호와 보정값을 이름으로 정해둔다
#define SOIL 35            // 토양수분 센서가 연결된 아날로그 핀 (확장쉴드 A2 줄 = GPIO35)
#define SOIL_DRY_RAW 4095  // ★ 공기 중(바싹 마름)에서 시리얼로 잰 '아날로그' 값 (이 키트 센서는 마를수록 커요!)
#define SOIL_WET_RAW 950   // ★ 물컵에 담갔을 때 잰 '아날로그' 값 — 내 센서 값으로 바꾸세요!

// 처음 한 번만 실행
void setup() {
  Serial.begin(115200);   // 시리얼 통신 시작 (시리얼 모니터도 115200으로!)
}

// 무한 반복
void loop() {
  int raw = analogRead(SOIL);   // 센서의 아날로그 값 읽기: 0~4095 (우노는 0~1023이었어요!)
  // map(마른 값 → 0%, 젖은 값 → 100%): 두 기준점 사이에서 비율 계산
  // 젖은 값이 마른 값보다 작은(반대 방향) 센서여도 map이 알아서 뒤집어 계산해요!
  // constrain(): 보정 범위를 벗어난 값은 0~100 안으로 잘라내기
  int pct = constrain(map(raw, SOIL_DRY_RAW, SOIL_WET_RAW, 0, 100), 0, 100);
  Serial.printf("아날로그 %d  →  토양습도 %d%%\n", raw, pct);   // 두 값을 함께 출력
  delay(500);   // 0.5초마다 측정
}

/*
  [2점 보정 순서 — 딱 두 번만 재면 돼요]
  1. 이 코드를 그대로 업로드하고 시리얼 모니터(115200)를 켜요
  2. 센서를 공기 중에 두고 '아날로그' 값 확인 → SOIL_DRY_RAW 에 입력
  3. 센서 아래쪽만 물컵에 담그고 '아날로그' 값 확인 → SOIL_WET_RAW 에 입력
     (⚠ 위쪽 기판까지 담그면 안 돼요!)
  4. 재업로드 → 공기 중 0% / 물속 100% 가 나오면 보정 완료!
  5. 이 두 값을 05·06 코드의 같은 이름 칸에도 복사하세요.

  [진단 — 값이 이상할 때]
  - '아날로그' 값이 공기/물에서 확실히 달라진다 → 센서 정상! 두 값만 위에 넣으면 끝
  - '아날로그' 값이 아예 안 변한다(계속 0 또는 4095 근처)
    → 센서가 아니라 배선 문제! 신호선(AO)이 확장쉴드 A2 줄의 S 칸에 꽂혔는지,
      G·V가 제대로 연결됐는지 확인하세요 (핀이 붕 뜨면 4095 근처가 계속 나와요)
*/
